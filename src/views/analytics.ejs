<%- include('partials/header') %>

<h1 class="mb-4">Analytics</h1>

<div class="card mb-4">
  <div class="card-header">A. Registrations by Category</div>
  <div class="table-responsive">
    <table class="table mb-0">
      <thead><tr><th>Category</th><th>Number of events</th><th>Confirmed registrations</th></tr></thead>
      <tbody>
      <% byCategory.forEach(function(c) { %>
        <tr><td><%= c._id %></td><td><%= c.eventsCount %></td><td><%= c.totalConfirmed %></td></tr>
      <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">B. Top 5 Most Popular Events</div>
  <div class="table-responsive">
    <table class="table mb-0">
      <thead><tr><th>Title</th><th>Category</th><th>Capacity</th><th>Confirmed</th><th>Occupancy</th></tr></thead>
      <tbody>
      <% topEvents.forEach(function(e) { %>
        <tr><td><%= e.title %></td><td><%= e.category %></td><td><%= e.capacity %></td><td><%= e.confirmedCount %></td><td><%= e.occupancy %>%</td></tr>
      <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">C. Users With No Registration</div>
  <div class="table-responsive">
    <table class="table mb-0">
      <thead><tr><th>Name</th><th>Email</th><th>Department</th></tr></thead>
      <tbody>
      <% usersNoReg.forEach(function(u) { %>
        <tr><td><%= u.firstName %> <%= u.lastName %></td><td><%= u.email %></td><td><%= u.department %></td></tr>
      <% }); %>
      <% if (usersNoReg.length === 0) { %>
        <tr><td colspan="3" class="text-muted text-center">Every user has at least one registration.</td></tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">D. Events Above Average Occupancy (overall average: <%= avgOccupancy %>%)</div>
  <div class="table-responsive">
    <table class="table mb-0">
      <thead><tr><th>Title</th><th>Category</th><th>Capacity</th><th>Confirmed</th><th>Occupancy</th></tr></thead>
      <tbody>
      <% aboveAverage.forEach(function(e) { %>
        <tr><td><%= e.title %></td><td><%= e.category %></td><td><%= e.capacity %></td><td><%= e.confirmedCount %></td><td><%= e.occupancy %>%</td></tr>
      <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">E. Most Used Tags</div>
  <div class="table-responsive">
    <table class="table mb-0">
      <thead><tr><th>Tag</th><th>Number of events</th></tr></thead>
      <tbody>
      <% topTags.forEach(function(t) { %>
        <tr><td><%= t._id %></td><td><%= t.count %></td></tr>
      <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">F. Events by Month</div>
  <div class="table-responsive">
    <table class="table mb-0">
      <thead><tr><th>Month</th><th>Total events</th><th>Total registrations</th></tr></thead>
      <tbody>
      <% byMonth.forEach(function(m) { %>
        <tr><td><%= m._id %></td><td><%= m.totalEvents %></td><td><%= m.totalRegistrations %></td></tr>
      <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
