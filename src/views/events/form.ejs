<%- include('../partials/header') %>

<h1><%= event && event._id ? 'Edit Event' : 'New Event' %></h1>

<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<form method="POST" action="<%= event && event._id ? '/events/' + event._id + '?_method=PUT' : '/events' %>" class="card p-4 shadow-sm">
  <div class="mb-3">
    <label class="form-label">Title</label>
    <input type="text" class="form-control" name="title" required value="<%= event ? event.title : '' %>">
  </div>
  <div class="mb-3">
    <label class="form-label">Description</label>
    <textarea class="form-control" name="description" rows="3"><%= event ? event.description : '' %></textarea>
  </div>
  <div class="row">
    <div class="col-md-6 mb-3">
      <label class="form-label">Category</label>
      <input type="text" class="form-control" name="category" required value="<%= event ? event.category : '' %>">
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label">Tags (comma-separated)</label>
      <input type="text" class="form-control" name="tags" value="<%= event && event.tags ? (Array.isArray(event.tags) ? event.tags.join(', ') : event.tags) : '' %>">
    </div>
  </div>
  <div class="row">
    <div class="col-md-6 mb-3">
      <label class="form-label">Start date</label>
      <input type="datetime-local" class="form-control" name="startDate" required
        value="<%= event && event.startDate ? new Date(event.startDate).toISOString().slice(0,16) : '' %>">
    </div>
    <div class="col-md-6 mb-3">
      <label class="form-label">End date</label>
      <input type="datetime-local" class="form-control" name="endDate" required
        value="<%= event && event.endDate ? new Date(event.endDate).toISOString().slice(0,16) : '' %>">
    </div>
  </div>
  <div class="mb-3">
    <label class="form-label">Capacity</label>
    <input type="number" min="1" class="form-control" name="capacity" required value="<%= event ? event.capacity : '' %>">
  </div>

  <h5 class="mt-3">Location (embedded)</h5>
  <div class="row">
    <div class="col-md-4 mb-3">
      <label class="form-label">Building</label>
      <input type="text" class="form-control" name="building" required value="<%= event && event.location ? event.location.building : '' %>">
    </div>
    <div class="col-md-4 mb-3">
      <label class="form-label">Room</label>
      <input type="text" class="form-control" name="room" required value="<%= event && event.location ? event.location.room : '' %>">
    </div>
    <div class="col-md-4 mb-3">
      <label class="form-label">Campus</label>
      <input type="text" class="form-control" name="campus" required value="<%= event && event.location ? event.location.campus : '' %>">
    </div>
  </div>

  <div class="mb-3">
    <label class="form-label">Organizer</label>
    <select class="form-select" name="organizerId" required>
      <option value="">-- select organizer --</option>
      <% users.forEach(function(u) { %>
        <option value="<%= u._id %>" <%= event && event.organizerId && event.organizerId.toString() === u._id.toString() ? 'selected' : '' %>>
          <%= u.firstName %> <%= u.lastName %>
        </option>
      <% }); %>
    </select>
  </div>

  <button class="btn btn-primary" type="submit">Save</button>
  <a href="/events" class="btn btn-link">Cancel</a>
</form>

<%- include('../partials/footer') %>
