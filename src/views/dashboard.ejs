<%- include('partials/header') %>

<div class="hero-banner">
  <div class="hero-date"><i class="bi bi-calendar3 me-1"></i>Tableau de bord</div>
  <h1>Bienvenue sur Campus Event Manager</h1>
  <p>Voici un apercu en temps reel de l'activite culturelle et evenementielle du campus.</p>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="stat-card">
      <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
      <div><h2><%= usersCount %></h2><p class="stat-label">Utilisateurs</p></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card">
      <div class="stat-icon"><i class="bi bi-calendar-event-fill"></i></div>
      <div><h2><%= eventsCount %></h2><p class="stat-label">Evenements</p></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card">
      <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
      <div><h2><%= upcomingCount %></h2><p class="stat-label">A venir</p></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card">
      <div class="stat-icon"><i class="bi bi-ticket-perforated-fill"></i></div>
      <div><h2><%= totalRegistrations %></h2><p class="stat-label">Inscriptions</p></div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-7">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-clock-history me-2"></i>Prochains evenements</div>
      <div class="table-responsive" style="border:none; border-radius:0 0 16px 16px;">
        <table class="table mb-0">
          <thead><tr><th>Titre</th><th>Categorie</th><th>Date de debut</th></tr></thead>
          <tbody>
          <% nextEvents.forEach(function(e) { %>
            <tr>
              <td><a href="/events/<%= e._id %>"><%= e.title %></a></td>
              <td><span class="pill"><%= e.category %></span></td>
              <td class="text-muted"><%= new Date(e.startDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
            </tr>
          <% }); %>
          <% if (nextEvents.length === 0) { %>
            <tr><td colspan="3" class="text-muted text-center py-4">Aucun evenement a venir.</td></tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-md-5">
    <div class="card spotlight-card h-100">
      <div class="card-body">
        <div class="spotlight-badge"><i class="bi bi-star-fill"></i> A la une</div>
        <% if (mostPopular) { %>
          <h3 class="mb-2"><a href="/events/<%= mostPopular._id %>" style="color: var(--ink); text-decoration:none;"><%= mostPopular.title %></a></h3>
          <span class="pill mb-3 d-inline-block"><%= mostPopular.category %></span>
          <div class="d-flex align-items-baseline gap-2 mt-3">
            <span style="font-family:'Playfair Display', serif; font-size:2.4rem; font-weight:700; color: var(--gold-dark);"><%= mostPopular.confirmedCount %></span>
            <span class="text-muted">inscriptions confirmees</span>
          </div>
        <% } else { %>
          <p class="text-muted mb-0">Aucun evenement pour le moment.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
